{
  "version": "7.3",
  "screens": [
    {
      "id": "UPDATE_APPOINTMENT",
      "title": "Modificar cita",
      "terminal": true,
      "success": true,
      "data": {
        "default_name": {
          "type": "string",
          "__example__": "Gabriel Santos"
        },
        "default_date": {
          "type": "string",
          "__example__": "2026-11-20"
        },
        "default_time": {
          "type": "string",
          "__example__": "10:00"
        },
        "default_treatment": {
          "type": "string",
          "__example__": "Limpieza"
        },
        "default_payment_method": {
          "type": "string",
          "__example__": "PAY_EFECTIVO"
        },
        "default_payment_status": {
          "type": "string",
          "__example__": "PAT_STAT_COMPLETE"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Modificar cita"
          },
          {
            "type": "TextBody",
            "text": "Los datos actuales están precargados. Cambie lo que necesite."
          },
          {
            "type": "TextInput",
            "name": "patient_name",
            "label": "Nombre del paciente",
            "input-type": "text",
            "required": true,
            "init-value": "${data.default_name}"
          },
          {
            "type": "DatePicker",
            "name": "new_date",
            "label": "Nueva fecha",
            "init-value": "${data.default_date}"
          },
          {
            "type": "TextInput",
            "name": "new_time",
            "label": "Nueva hora (HH:mm)",
            "input-type": "text",
            "helper-text": "Formato 24h, ejemplo 10:00",
            "init-value": "${data.default_time}"
          },
          {
            "type": "TextInput",
            "name": "patient_treatment",
            "label": "Tratamiento",
            "input-type": "text",
            "required": false,
            "init-value": "${data.default_treatment}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "payment_method",
            "label": "Forma de pago",
            "required": false,
            "init-value": "${data.default_payment_method}",
            "data-source": [
              {
                "id": "PAY_EFECTIVO",
                "title": "Efectivo"
              },
              {
                "id": "PAY_TRANSFERENCIA",
                "title": "Transferencia"
              }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "payment_status",
            "label": "Estado del pago",
            "required": false,
            "init-value": "${data.default_payment_status}",
            "data-source": [
              {
                "id": "PAT_STAT_COMPLETE",
                "title": "Completo"
              },
              {
                "id": "PAT_STAT_PARTIALLY",
                "title": "Parcialmente"
              },
              {
                "id": "PAT_STAT_INDEBT",
                "title": "En deuda"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Cambiar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "patient_name": "${form.patient_name}",
                "new_date": "${form.new_date}",
                "new_time": "${form.new_time}",
                "patient_treatment": "${form.patient_treatment}",
                "payment_method": "${form.payment_method}",
                "payment_status": "${form.payment_status}"
              }
            }
          }
        ]
      }
    }
  ]
}

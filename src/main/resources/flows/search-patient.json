{
  "version": "7.3",
  "screens": [
    {
      "id": "SEARCH_PATIENT",
      "title": "Buscar paciente",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Buscar paciente"
          },
          {
            "type": "TextBody",
            "text": "Escriba el nombre del paciente o seleccione la fecha de la cita."
          },
          {
            "type": "TextInput",
            "name": "patient_name",
            "label": "Nombre del paciente",
            "input-type": "text",
            "required": false
          },
          {
            "type": "DatePicker",
            "name": "new_date",
            "label": "Fecha de la cita"
          },
          {
            "type": "Footer",
            "label": "Buscar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "patient_name": "${form.patient_name}",
                "new_date": "${form.new_date}"
              }
            }
          }
        ]
      }
    }
  ]
}

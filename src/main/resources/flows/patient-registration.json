{
  "version": "7.3",
  "screens": [
    {
      "id": "PATIENT_REGISTRATION",
      "title": "Registrar paciente",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Registrar paciente"
          },
          {
            "type": "TextBody",
            "text": "Complete los datos del paciente y la fecha de la cita."
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Nombre y apellido",
            "input-type": "text",
            "required": true
          },
          {
            "type": "TextInput",
            "name": "age",
            "label": "Edad",
            "input-type": "number",
            "required": true
          },
          {
            "type": "DatePicker",
            "name": "appointment_date",
            "label": "Fecha de la cita"
          },
          {
            "type": "TextInput",
            "name": "appointment_time",
            "label": "Hora (HH:mm)",
            "input-type": "text",
            "required": true,
            "helper-text": "Formato 24h, ejemplo 10:00"
          },
          {
            "type": "Footer",
            "label": "Registrar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "full_name": "${form.full_name}",
                "age": "${form.age}",
                "appointment_date": "${form.appointment_date}",
                "appointment_time": "${form.appointment_time}"
              }
            }
          }
        ]
      }
    }
  ]
}
